# =========================================
# SCP AKTÖRLÜK & RAPOR YÖNETİM PANELİ - ENV
# =========================================

# --- Database (Prisma) ---
# Supabase / Railway / Neon uyumlu PostgreSQL connection string
# Örn (Supabase pooler): postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/scp_panel?schema=public"
# Migration'lar için direkt (non-pooled) bağlantı — Supabase kullanıyorsan zorunlu
DIRECT_URL="postgresql://user:password@localhost:5432/scp_panel?schema=public"

# --- NextAuth ---
# `openssl rand -base64 32` ile üretebilirsin
NEXTAUTH_SECRET="degistirilecek-cok-gizli-bir-anahtar"
# Local: http://localhost:3000  |  Prod: https://senin-projen.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# --- Discord OAuth2 (Discord Developer Portal > OAuth2) ---
DISCORD_CLIENT_ID="1234567890123456789"
DISCORD_CLIENT_SECRET="discord-oauth2-client-secret"

# --- Discord Bot (Discord Developer Portal > Bot) ---
DISCORD_BOT_TOKEN="discord-bot-token"
DISCORD_GUILD_ID="sunucu-id-si"

# --- Discord Kanal ID'leri ---
DISCORD_SCP_ASSIGNMENT_CHANNEL_ID="kanal-id"      # SCP atama bildirimleri
DISCORD_REPORT_CHANNEL_ID="kanal-id"              # Yeni rapor bildirimleri
DISCORD_REPORT_LOG_CHANNEL_ID="kanal-id"          # Onay/Red/Revizyon logları

# --- Discord Rol ID'leri (Sunucu Ayarları > Roller'den kopyala) ---
ROLE_TRIAL_ACTOR_ID="rol-id"    # Deneme Aktör
ROLE_ACTOR_ID="rol-id"          # Aktör
ROLE_SENIOR_ACTOR_ID="rol-id"   # Kıdemli Aktör
ROLE_HEAD_ADMIN_ID="rol-id"     # Üst Aktör
ROLE_CHIEF_ACTOR_ID="rol-id"    # Baş Aktör
ROLE_ACTOR_MANAGER_ID="rol-id"  # Aktör Sorumlusu
