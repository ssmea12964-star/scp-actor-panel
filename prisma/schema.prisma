// ============================================
// SCP AKTÖRLÜK & RAPOR YÖNETİM PANELİ - PRISMA
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Rol Hiyerarşisi ---
// Sıra önemli: yükseldikçe yetki artar (bkz. src/lib/roles.ts -> ROLE_HIERARCHY)
enum ActorRole {
  DENEME_AKTOR
  AKTOR
  KIDEMLI_AKTOR
  UST_AKTOR
  BAS_AKTOR
  AKTOR_SORUMLUSU
}

enum ReportStatus {
  BEKLEMEDE
  REVIZYON_ISTENDI
  ONAYLANDI
  REDDEDILDI
}

// --- NextAuth gerekli tablolar ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Uygulama modelleri ---
model User {
  id            String    @id @default(cuid())
  discordId     String    @unique
  name          String?
  username      String?
  image         String?
  email         String?   @unique
  role          ActorRole @default(DENEME_AKTOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]

  reportsAuthored   Report[]         @relation("ReportAuthor")
  reportsReviewed   Report[]         @relation("ReportReviewer")
  scpAssignments    ScpAssignment[]  @relation("AssignedActor")
  scpAssignmentsMade ScpAssignment[] @relation("AssignedBy")
}

model ScpAssignment {
  id           String   @id @default(cuid())
  scpName      String   // Örn: SCP-811
  roleNote     String?  @db.Text
  scheduledAt  DateTime
  createdAt    DateTime @default(now())

  actor        User     @relation("AssignedActor", fields: [actorId], references: [id])
  actorId      String

  assignedBy   User     @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedById String

  discordMessageId String?
}

model Report {
  id               String       @id @default(cuid())
  scpOrRoleName    String       // SCP / Rol Adı
  roleDate         DateTime     // Tarih
  roleDurationMin  Int          // Rol Süresi (dakika)
  accompaniedStaff String?      @db.Text // Eşlik Eden Personel
  summary          String       @db.Text // Günün Kısa Özeti

  status           ReportStatus @default(BEKLEMEDE)
  rejectionReason  String?      @db.Text
  reviewNote       String?      @db.Text

  author       User     @relation("ReportAuthor", fields: [authorId], references: [id])
  authorId     String

  reviewedBy   User?    @relation("ReportReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  discordMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([authorId])
}
